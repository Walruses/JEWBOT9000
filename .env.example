# Copy to .env and adjust. Never commit real credentials.
IB_HOST=127.0.0.1
# 4002 = IB Gateway paper, 7497 = TWS paper, 4001 = Gateway live, 7496 = TWS live
IB_PORT=4002
IB_CLIENT_ID=1

# Must be set to "yes" (and --mode live passed) before the agent will touch a live account.
TRADING_ALLOW_LIVE=no

# --- Account & position sizing ---
# margin: pattern day trader rule applies under $25k (3 day trades / 5 business days)
# cash:   no day-trade limit, but long only and settled cash only
ACCOUNT_TYPE=margin
# Used when the broker doesn't report equity (sim, backtests)
ACCOUNT_EQUITY=25000
# Max loss per trade if the stop is hit, as % of equity
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=2.0
MAX_POSITION_PCT=50
MAX_GROSS_EXPOSURE_PCT=100
STOP_COOLDOWN_MINUTES=60

# Hard backstops (shares / $ per order)
RISK_MAX_POSITION=5000
RISK_MAX_ORDER_QTY=5000
RISK_MAX_ORDER_NOTIONAL=25000
RISK_MAX_DAILY_LOSS=500
RISK_MAX_ORDERS_PER_SEC=40
RISK_MAX_PRICE_DEVIATION_BPS=50

# --- AI analyst & data sources (each source is enabled only when configured) ---
ANTHROPIC_API_KEY=
# Main model: SEC filings and pre-open briefings. Routine model: everything else
# (leave empty to use the main model for all).
ANALYST_MODEL=claude-opus-5
ANALYST_ROUTINE_MODEL=claude-sonnet-5
ANALYST_EFFORT=medium
# Poll interval during market hours (5 min pre/after-market, 30 min overnight)
NEWS_POLL_SECONDS=60
# News headlines through your IBKR connection (paper/live modes)
IBKR_NEWS=yes
# SEC asks for "Company/Name contact@email" -- https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-agent/0.1 by your_reddit_username

# --- Runtime ---
STATE_FILE=data/state.json
RECORD_DIR=data/recordings
# Eastern time. No new positions outside START..FLATTEN; flatten from FLATTEN to 16:00.
SESSION_START=09:35
SESSION_FLATTEN=15:50
JOURNAL_FILE=data/journal.db
# Written by `python -m trading_agent.report --write`; loaded on startup if present
QUALITY_FILE=data/source_quality.json

# --- Costs (IBKR Pro Tiered defaults; check your account's schedule) ---
COMMISSION_PER_SHARE=0.0035
COMMISSION_MIN=0.35
# Approximate exchange/clearing/regulatory fees
EXTRA_FEES_PER_SHARE=0
# Only add exposure when expected gain >= this multiple of round-trip commission
COST_SAFETY_MULTIPLE=2.0
# Expected move of a full-conviction view; replaced by the journal estimate once available
EDGE_BPS_FULL_CONVICTION=50

# --- Tiers (see README "What gets traded") ---
MIN_PRICE=1.0
PENNY_BELOW=5.0
MAX_SPREAD_PCT=0.5
PENNY_MAX_SPREAD_PCT=2.0
PENNY_RISK_PER_TRADE_PCT=0.5
PENNY_MAX_POSITION_PCT=10
# Penny entries need the analyst's sentiment and confidence both at least this high
PENNY_MIN_SCORE=0.8
PENNY_MIN_CONFIDENCE=0.8
# Stop = this x the stock's 30-minute volatility, within the tier's bounds
STOP_VOL_MULTIPLE=2.0

# --- Daily review (training period) ---
# Model that reviews each day after the close (needs 30-day data retention on your org;
# otherwise use claude-opus-5-5)
REVIEW_MODEL=claude-fable-5-1
# Send each day's bundle to the reviewer automatically after the close (costs ~$1-5/day)
REVIEW_AUTO_ANALYZE=no
